      },
      "id": 2,
      "interval": "1ms",
      "maxDataPoints": 600,
      "options": {
        "legend": {
          "calcs": [
            "min",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "single",
          "sort": "none"
        }
      },
      "pluginVersion": "11.6.5",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "fepg8hwzyq9dsd"
          },
          "query": "detail = ${data_detail:doublequote}\n\nreadData = () =>\n    from(bucket: ${bucket:doublequote})\n        |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n        |> filter(fn: (r) =>\n            r._measurement == ${measurement:doublequote} and\n            r._field == \"value\" and\n            r.name == ${device:doublequote} and\n            (r.channel !~ /^CH[0-2]$/ or r.channel =~ /^(${show_ch:regex})$/) and\n            (r.channel !~ /^TTL[1-4]$/ or r.channel =~ /^(${show_ttl:regex})$/)\n        )\n\nm4 = () => {\n    width = if detail == \"auto\" then v.windowPeriod else duration(v: detail)\n    keys = [\"_measurement\", \"_field\", \"name\", \"channel\"]\n\n    firstPoints = readData()\n        |> window(every: width, createEmpty: false)\n        |> first()\n        |> group(columns: keys)\n\n    minPoints = readData()\n        |> window(every: width, createEmpty: false)\n        |> min()\n        |> group(columns: keys)\n\n    maxPoints = readData()\n        |> window(every: width, createEmpty: false)\n        |> max()\n        |> group(columns: keys)\n\n    lastPoints = readData()\n        |> window(every: width, createEmpty: false)\n        |> last()\n        |> group(columns: keys)\n\n    return union(tables: [\n        firstPoints, minPoints, maxPoints, lastPoints\n    ])\n        |> unique(column: \"_time\")\n        |> sort(columns: [\"_time\"])\n        |> keep(columns: [\n            \"_time\", \"_value\", \"_measurement\",\n            \"_field\", \"name\", \"channel\"\n        ])\n}\n\nresult = if detail == \"raw\" then readData() else m4()\nresult |> yield(name: \"selected_detail\")",
          "refId": "A"
        }
      ],
      "title": "Selected detail (${data_detail:text}) - ${device}",
      "type": "timeseries"
    }
